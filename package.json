{
  "name": "suja-life-tools",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check dist/shared/app.js && node --check dist/shared/platform.js",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "test:rules": "firebase emulators:exec --project demo-suja-life-tools --only database \"node --test tests/rules.integration.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "firebase": "11.10.0",
    "firebase-tools": "14.22.0"
  }
}
